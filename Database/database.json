  "views": {
    "v_inventario_stock_bajo": {
      "description": "Vista de inventario con stock bajo",
      "columns": ["id", "nombre", "stock_actual", "stock_minimo", "sucursal_nombre", "categoria_nombre"],
      "condition": "stock_actual <= stock_minimo AND activo = TRUE"
    },
    "v_pedidos_hoy": {
      "description": "Vista de pedidos del día",
      "columns": ["id", "numero_pedido", "cliente_nombre", "numero_mesa", "usuario_nombre", "sucursal_nombre", "estado", "tipo_pedido", "total", "fecha_pedido"],
      "condition": "DATE(fecha_pedido) = CURDATE()"
    },
    "v_comandas_pendientes": {
      "description": "Vista de comandas pendientes",
      "columns": ["id", "numero_comanda", "numero_pedido", "estado", "prioridad", "tiempo_estimado", "usuario_asignado", "sucursal_nombre", "fecha_creacion", "minutos_transcurridos"],
      "condition": "estado IN ('pendiente', 'en_preparacion')"
    }
  },
  "procedures": {
    "sp_crear_pedido": {
      "description": "Procedimiento para crear un nuevo pedido",
      "parameters": {
        "inputs": [
          "p_cliente_id INT",
          "p_mesa_id INT", 
          "p_usuario_id INT",
          "p_sucursal_id INT",
          "p_tipo_pedido VARCHAR(20)",
          "p_notas TEXT"
        ],
        "outputs": [
          "p_pedido_id INT",
          "p_numero_pedido VARCHAR(50)"
        ]
      }
    },
    "sp_agregar_item_pedido": {
      "description": "Procedimiento para agregar item a pedido",
      "parameters": {
        "inputs": [
          "p_pedido_id INT",
          "p_producto_id INT",
          "p_cantidad INT",
          "p_notas_item TEXT"
        ]
      }
    },
    "sp_actualizar_stock": {
      "description": "Procedimiento para actualizar stock",
      "parameters": {
        "inputs": [
          "p_producto_id INT",
          "p_cantidad INT",
          "p_tipo_movimiento VARCHAR(20)",
          "p_motivo VARCHAR(200)",
          "p_usuario_id INT",
          "p_sucursal_id INT",
          "p_pedido_id INT"
        ]
      }
    }
  },
  "functions": {
    "fn_ventas_dia": {
      "description": "Función para calcular ventas del día",
      "parameters": ["p_fecha DATE", "p_sucursal_id INT"],
      "returns": "DECIMAL(10,2)"
    },
    "fn_pedidos_pendientes": {
      "description": "Función para contar pedidos pendientes",
      "parameters": ["p_sucursal_id INT"],
      "returns": "INT"
    }
  },
  "triggers": {
    "tr_actualizar_stock_pedido": {
      "description": "Trigger para actualizar stock al confirmar pedido",
      "table": "pedidos",
      "event": "AFTER UPDATE",
      "condition": "OLD.estado = 'pendiente' AND NEW.estado = 'en_preparacion'"
    },
    "tr_liberar_mesa_pedido": {
      "description": "Trigger para liberar mesa al completar pedido", 
      "table": "pedidos",
      "event": "AFTER UPDATE",
      "condition": "NEW.estado = 'entregado' AND NEW.mesa_id IS NOT NULL"
    }
  },
